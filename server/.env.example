# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/edumatrix?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Stripe Payments (Optional for startup, required for fee payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Assistant
GIMINI_API_KEY=your_google_gemini_api_key

# LiveKit SFU Virtual Classroom
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
