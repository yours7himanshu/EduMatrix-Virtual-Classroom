{
  "name": "edumatrix-backend-worker",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "alias": {
    "mongoose": "./src/mongoose-edge.js"
  },
  "vars": {
    "NODE_ENV": "development"
  },
  "env": {
    "staging": {
      "name": "edumatrix-backend-staging",
      "vars": {
        "NODE_ENV": "staging",
        "ENABLE_DIAGNOSTICS": "false"
      }
    },
    "proxy": {
      "name": "edumatrix-proxy-worker",
      "main": "src/proxy.js",
      "vars": {
        "ORIGIN_URL": "http://127.0.0.1:5000"
      }
    }
  }
}
